# Copy to backend/.env.local for local API runs (ignored by Git).
# Spring Boot loads it when started from the repository root or backend/.
# Use KEY=value without export or surrounding quotes; shell/IDE environment variables override it.
SERVER_ADDRESS=127.0.0.1
PORT=8081
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/godeck
DATABASE_USER=godeck
DATABASE_PASSWORD=godeck-local-only
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
AUTH_BYPASS=false
GODECK_OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
GODECK_DATA_DIR=./data/presentations
