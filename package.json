{
  "name": "godeck",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "pnpm --filter @godeck/frontend dev",
    "build": "pnpm --filter @godeck/frontend build",
    "start": "pnpm --filter @godeck/frontend start",
    "typecheck": "pnpm --filter @godeck/frontend typecheck",
    "backend:dev": "bash scripts/backend-dev.sh",
    "document-worker:dev": "bash scripts/document-worker.sh",
    "document-worker:build": "bash scripts/document-worker.sh build",
    "document-worker:test": "bash scripts/document-worker.sh test",
    "backend:test": "bash scripts/backend-dev.sh test",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose stop",
    "test:bridge": "python3 -m unittest discover -s scripts -p 'test_v0_gitlab_bridge.py'",
    "test:migrations": "node scripts/test-draft-migration.mjs",
    "test:auth": "python3 scripts/auth-smoke.py",
    "backend:test:unit": "bash scripts/backend-dev.sh test '-Dtest=*Test,!*IntegrationTest,!DevelopmentAuthBypassTest'",
    "backend:test:integration": "bash scripts/backend-dev.sh test '-Dtest=*IntegrationTest,DevelopmentAuthBypassTest'",
    "test:frontend": "node --experimental-strip-types --test frontend/lib/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:debug": "node scripts/e2e.mjs --debug",
    "test:e2e:types": "pnpm --filter @godeck/frontend exec tsc --noEmit -p ../e2e/tsconfig.json",
    "test:e2e:report": "playwright show-report",
    "verify": "pnpm test:frontend && pnpm typecheck && pnpm test:e2e:types && pnpm test:migrations && pnpm document-worker:test && pnpm backend:test && pnpm test:e2e"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "24.10.4",
    "@types/pg": "^8.23.1",
    "fflate": "^0.8.3",
    "pg": "^8.23.1"
  }
}
