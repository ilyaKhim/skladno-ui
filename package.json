{
  "name": "godeck",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "pnpm --filter @godeck/frontend dev",
    "build": "pnpm --filter @godeck/frontend build",
    "start": "pnpm --filter @godeck/frontend start",
    "typecheck": "pnpm --filter @godeck/frontend typecheck",
    "backend:dev": "node scripts/backend-dev.cjs",
    "document-worker:dev": "node scripts/document-worker.cjs",
    "document-worker:build": "node scripts/document-worker.cjs build",
    "document-worker:test": "node scripts/document-worker.cjs test",
    "backend:test": "node scripts/backend-dev.cjs test",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose stop",
    "test:bridge": "python3 -m unittest discover -s scripts -p 'test_v0_gitlab_bridge.py'",
    "test:migrations": "node scripts/test-draft-migration.mjs",
    "test:auth": "python3 scripts/auth-smoke.py",
    "backend:test:unit": "node scripts/backend-dev.cjs test \"-Dtest=*Test,!*IntegrationTest,!DevelopmentAuthBypassTest\"",
    "backend:test:integration": "node scripts/backend-dev.cjs test \"-Dtest=*IntegrationTest,DevelopmentAuthBypassTest\"",
    "test:frontend": "node --experimental-strip-types --test frontend/lib/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:smoke": "node scripts/e2e.mjs --smoke",
    "test:e2e:diagnostic": "node scripts/e2e.mjs --diagnostic",
    "test:e2e:debug": "node scripts/e2e.mjs --debug=inspector",
    "test:e2e:runner": "node --test scripts/e2e-run-guard.test.mjs scripts/tool-commands.test.cjs scripts/e2e-build.test.mjs scripts/e2e-reporter.test.cjs",
    "test:e2e:types": "pnpm --filter @godeck/frontend exec tsc --noEmit -p ../e2e/tsconfig.json",
    "test:e2e:report": "playwright show-report",
    "verify": "pnpm test:frontend && pnpm typecheck && pnpm test:e2e:types && pnpm test:e2e:runner && pnpm test:migrations && pnpm document-worker:test && pnpm backend:test && pnpm test:e2e"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "24.10.4",
    "@types/pg": "^8.23.1",
    "fflate": "^0.8.3",
    "pg": "^8.23.1"
  }
}
